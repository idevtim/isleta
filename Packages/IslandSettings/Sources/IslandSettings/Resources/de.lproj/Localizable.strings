/* Sources ▸ Focus */
"sources.focus" = "Fokus";
"sources.focus.respect" = "Still bleiben, solange ein Fokus aktiv ist";
"sources.focus.allow" = "Fokus-Zugriff erlauben …";
"sources.focus.summary.granted" = "Solange ein Fokus aktiv ist, hält Isleta Kalenderhinweise zurück. Alles, was du selbst tust – eine Lautstärketaste, ein Timer, ein Titelwechsel – wird weiterhin gezeigt.";
"sources.focus.summary.notDetermined" = "Isleta hat noch nicht gefragt, ob es deinen Fokus sehen darf. Bis dahin beruhigt ein Fokus hier gar nichts: Die Insel zeigt Kalenderhinweise auch durch „Nicht stören“ hindurch.";
"sources.focus.summary.denied" = "Der Fokus-Zugriff ist aus, deshalb zeigt die Insel Kalenderhinweise durch „Nicht stören“ hindurch. Ihn in den Systemeinstellungen zu aktivieren ist das, was den Schalter oben überhaupt wirksam macht.";
"sources.focus.summary.unavailable" = "Dieser Build kann nicht nach dem Fokus fragen, deshalb zeigt die Insel Kalenderhinweise durch „Nicht stören“ hindurch, was der Schalter auch sagt.";

/* Glance ▸ Calendars */
"glance.calendars" = "Kalender";
"glance.calendars.allow" = "Kalenderzugriff erlauben …";
"glance.calendars.summary.granted" = "Wähle, welche Kalender die Insel zeigt. Ist keiner gewählt, zeigt sie alle.";
"glance.calendars.summary.granted.empty" = "Isleta kann deine Kalender sehen, und auf diesem Mac gibt es noch keine.";
"glance.calendars.summary.notDetermined" = "Isleta hat noch nicht nach deinem Kalender gefragt. Deine Termine werden nie gespeichert, nie irgendwohin gesendet und nie in Isletas Protokolle geschrieben.";
"glance.calendars.summary.denied" = "Der Kalenderzugriff ist aus, deshalb hat die Insel nichts zu deinem Tag zu zeigen. Ihn in den Systemeinstellungen zu aktivieren bringt zurück, was als Nächstes ansteht.";
"glance.calendars.summary.restricted" = "Der Kalenderzugriff wird auf diesem Mac verwaltet. Nichts, was du in Isleta änderst, ändert daran etwas.";
"glance.calendars.summary.writeOnly" = "Isleta hat nur Schreibzugriff auf den Kalender; der erlaubt das Hinzufügen von Terminen und gibt keine zum Lesen zurück. Die Insel braucht vollen Zugriff.";

/* Glance ▸ Weather and Where */
"glance.weather" = "Wetter";
"glance.weather.summary.granted" = "Die Insel zeigt das Wetter dort, wo du bist, oder in einer Stadt deiner Wahl.";
"glance.weather.summary.notDetermined" = "Isleta hat noch nicht nach deinem Standort gefragt. Du kannst stattdessen eine Stadt eintippen – das Wetter funktioniert so oder so.";
"glance.weather.summary.denied" = "Die Ortung ist aus, tippe also eine Stadt ein. Das Wetter funktioniert genauso; Isleta fragt nur nach dort statt nach hier.";
"glance.where.caption" = "Das Wetter funktioniert so oder so. Ist der Standort aus, fragt Isleta nach der Stadt, die du eintippst, statt nach der, in der du bist – sonst ändert sich nichts.";
"glance.where.useLocation" = "Meinen Standort verwenden";
"glance.where.refused" = "macOS lässt Isleta nicht auf deinen Standort zugreifen, deshalb lässt sich der Schalter nicht umlegen. Das änderst du, indem du Isleta in den Ortungsdiensten aktivierst – oder du tippst unten eine Stadt ein, was genauso gut funktioniert.";
"glance.where.city" = "Stadt";
"glance.where.city.example" = "Berlin";
"glance.where.city.caption" = "Tippe los und wähle deine Stadt aus der Liste. Einmal nachgeschlagen und gemerkt – eine Stadt bewegt sich nicht, deshalb fragt Isleta nur wieder nach, wenn du sie änderst.";
"glance.where.city.suggestions" = "Passende Städte";

