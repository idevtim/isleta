/* About */
"about.tagline" = "Die Aussparung, endlich nützlich.";
"about.acknowledgements" = "Danksagungen";
"about.acknowledgements.showLicense" = "Lizenz einblenden";
"about.acknowledgements.hideLicense" = "Lizenz ausblenden";
"about.acknowledgements.project" = "Projekt";
"about.acknowledgement.mediaRemoteAdapter" = "Liest, was gerade abgespielt wird. Apple hat die Now-Playing-API in macOS 15.4 auf eigene Prozesse beschränkt, und dies ist der unterstützte Weg zurück zu ihr.";
"about.acknowledgement.sparkle" = "Liefert Isletas Updates aus. Es prüft den Appcast, verifiziert jeden Download gegen den in dieser Kopie der App hinterlegten öffentlichen EdDSA-Schlüssel und installiert, was es verifiziert hat.";
"about.setupGuide.caption" = "Die vier Seiten, die du beim ersten Mal gesehen hast. Sie erklären, wo die Insel ist, was sie dir zeigen kann und welche Berechtigung was freischaltet – ein zweiter Blick lohnt sich, wenn du Isleta eine Weile benutzt hast.";
"about.quit.caption" = "Isleta hört auf, bis du es wieder öffnest. Es hat kein Dock-Symbol, deshalb sind dies und das Menüleistensymbol die beiden Wege hinaus – und das Menüleistensymbol kannst du ausschalten.";
"about.diagnostics" = "Diagnose";
"about.diagnostics.caption" = "Sichert eine einzige Textdatei – was Isleta auf diesem Mac sehen kann und sein jüngstes Protokoll. Sie enthält keinen Mitteilungstext, keine Titelnamen und keine Dateinamen und lässt sich deshalb gefahrlos an einen Fehlerbericht hängen.";
"about.reset" = "Von vorn";
"about.reset.caption" = "Setzt jede Einstellung auf jedem Bereich auf den ausgelieferten Standard zurück. Berechtigungen, die du in den Systemeinstellungen erteilt hast, bleiben unberührt.";
"about.reset.button" = "Auf Standardwerte zurücksetzen";
"about.reset.loadFailure" = "Deine gesicherten Einstellungen konnten nicht gelesen werden, dies sind deshalb die Standardwerte. (%@)";

