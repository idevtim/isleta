/* IslandActivities — de. English lives in the Swift source, as each call site's second argument. */

/* Section: the system HUD — spoken by VoiceOver, never drawn */
"hud.volume" = "Lautstärke";
"hud.muted" = "Stumm";
"hud.brightness" = "Bildschirmhelligkeit";

/* Section: the system HUD — the word drawn beside the glyph on a widened island. One noun, kept
   short: the island's width is measured against the longest of these, so a phrase where a noun will
   do widens the notch for everybody reading this language. */
"hud.volume.label" = "Lautstärke";
"hud.muted.label" = "Stumm";
"hud.brightness.label" = "Bildschirm";

/* Section: Now Playing — joining text, not labels */
"nowPlaying.metadataSeparator" = " — ";
"nowPlaying.a11ySeparator" = " von ";

/* Section: a Bluetooth device that has just connected */
"device.connected.a11y.battery" = "%1$@ verbunden, Batterie bei %2$lld Prozent";
"device.connected.a11y" = "%@ verbunden";
"device.connected.battery" = "%lld %%";
"device.connected.subtitle" = "Verbunden";

/* Section: a timer from Apple's Clock */
"timer.untitled" = "Timer";
"timer.paused" = "Pausiert";
"timer.finished" = "Zeit ist um";
"timer.finished.a11y" = "%@ abgelaufen";

/* Section: the shelf. shelf.itemCount is a plural — Localizable.stringsdict */
"shelf.title" = "Regal";

/* Section: what the actions menu offers to do to a file */
"convert.transcribe" = "Transkribieren";
"convert.compressVideo" = "Video komprimieren";
"convert.to" = "Umwandeln in %@";

/* Section: a joinable meeting */
"meeting.join" = "%@ beitreten";

/* Section: the glance, with nothing to show */
"glance.empty.granted" = "Heute nichts mehr";
"glance.empty.notDetermined" = "Isleta hat noch nicht nach deinem Kalender gefragt";
"glance.empty.denied" = "Kalenderzugriff in den Systemeinstellungen aktivieren";
"glance.empty.restricted" = "Der Kalenderzugriff wird auf diesem Mac verwaltet";
"glance.empty.writeOnly" = "Isleta kann Termine hinzufügen, aber nicht lesen";

/* Section: the glance's own formatting */
"glance.startsIn.now" = "Beginnt jetzt";
"glance.startsIn.minutes" = "In %lld Min.";
"glance.startsIn.hours" = "In %lld Std.";
"glance.day.today" = "Heute";
"glance.day.tomorrow" = "Morgen";
"glance.row.allDay" = "Ganztägig";

/* Section: drop actions. "AirDrop" is Apple's own name and is not in this table. */
"dropAction.revealInFinder" = "Im Finder zeigen";
"dropAction.copyToFolder" = "In Ordner kopieren …";
"dropAction.moveToFolder" = "In Ordner bewegen …";
"dropAction.copyLink" = "Link kopieren";

/* Section: work Isleta is doing to a file. fileAction.fileCount is a plural. */
"fileAction.a11y.running" = "%1$@, %2$@";
"fileAction.finished.subtitle" = "%@ im Regal";
"fileAction.a11y.finished" = "%1$@ abgeschlossen, %2$@";
"fileAction.a11y.failed" = "%1$@ fehlgeschlagen, %2$@";

/* Section: weather */
"weather.unit.celsius" = "°C";
"weather.unit.fahrenheit" = "°F";
"weather.temperature.compact" = "%lld°";
"weather.temperature.full" = "%1$lld %2$@";
"weather.temperature.range" = "H:%1$lld°  T:%2$lld°";
"weather.percentage" = "%lld %%";

// Now Playing — the audio format badge. Apple ships these two terms
// untranslated in Music itself in every language Isleta speaks, so they are
// keys rather than literals only because the day one locale does translate
// them, this is where it goes.
"nowPlaying.format.lossless" = "Lossless";
"nowPlaying.format.hiResLossless" = "Hi-Res Lossless";
"nowPlaying.format.dolbyAtmos" = "Dolby Atmos";
"nowPlaying.format.multichannel" = "Mehrkanal";
