"nowPlaying.format.hiResLossless" = "Hi-Res Lossless";
"nowPlaying.format.dolbyAtmos" = "Dolby Atmos";
"nowPlaying.format.multichannel" = "マルチチャンネル";

/* An update waiting */
"update.available.a11y" = "Isleta %@が利用可能です。";
