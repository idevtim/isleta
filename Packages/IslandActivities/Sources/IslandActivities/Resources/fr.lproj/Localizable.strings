// Now Playing — the audio format badge. Apple ships these two terms
// untranslated in Music itself in every language Isleta speaks, so they are
// keys rather than literals only because the day one locale does translate
// them, this is where it goes.
"nowPlaying.format.lossless" = "Lossless";
"nowPlaying.format.hiResLossless" = "Hi-Res Lossless";
"nowPlaying.format.dolbyAtmos" = "Dolby Atmos";
"nowPlaying.format.multichannel" = "Multicanal";
