/* IslandActivities — fr. English lives in the Swift source, as each call site's second argument. */

/* Section: the system HUD — spoken by VoiceOver, never drawn */
"hud.volume" = "Volume";
"hud.muted" = "Son coupé";
"hud.brightness" = "Luminosité de l’écran";

/* Section: the system HUD — the word drawn beside the glyph on a widened island. One noun, kept
   short: the island's width is measured against the longest of these, so a phrase where a noun will
   do widens the notch for everybody reading this language. */
"hud.volume.label" = "Volume";
"hud.muted.label" = "Son coupé";
"hud.brightness.label" = "Écran";

/* Section: Now Playing — joining text, not labels */
"nowPlaying.metadataSeparator" = " — ";
"nowPlaying.a11ySeparator" = " par ";

/* Section: a Bluetooth device that has just connected */
"device.connected.a11y.battery" = "%1$@ connecté, batterie à %2$lld pour cent";
"device.connected.a11y" = "%@ connecté";
"device.connected.battery" = "%lld %%";
"device.connected.subtitle" = "Connecté";

/* Section: a timer from Apple's Clock */
"timer.untitled" = "Minuteur";
"timer.paused" = "En pause";
"timer.finished" = "Temps écoulé";
"timer.finished.a11y" = "%@ terminé";

/* Section: the shelf. shelf.itemCount is a plural — Localizable.stringsdict */
"shelf.title" = "Étagère";

/* Section: what the actions menu offers to do to a file */
"convert.transcribe" = "Transcrire";
"convert.compressVideo" = "Compresser la vidéo";
"convert.to" = "Convertir en %@";

/* Section: a joinable meeting */
"meeting.join" = "Rejoindre %@";

/* Section: the glance, with nothing to show */
"glance.empty.granted" = "Rien d’autre aujourd’hui";
"glance.empty.notDetermined" = "Isleta n’a pas encore demandé l’accès à votre calendrier";
"glance.empty.denied" = "Activez l’accès au calendrier dans Réglages Système";
"glance.empty.restricted" = "L’accès au calendrier est géré sur ce Mac";
"glance.empty.writeOnly" = "Isleta peut ajouter des événements, mais pas les lire";

