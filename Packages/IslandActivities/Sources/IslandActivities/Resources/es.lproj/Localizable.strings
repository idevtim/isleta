/* IslandActivities — es. English lives in the Swift source, as each call site's second argument. */

/* Section: the system HUD — spoken by VoiceOver, never drawn */
"hud.volume" = "Volumen";
"hud.muted" = "Silenciado";
"hud.brightness" = "Brillo de la pantalla";

/* Section: the system HUD — the word drawn beside the glyph on a widened island. One noun, kept
   short: the island's width is measured against the longest of these, so a phrase where a noun will
   do widens the notch for everybody reading this language. */
"hud.volume.label" = "Volumen";
"hud.muted.label" = "Silenciado";
"hud.brightness.label" = "Pantalla";

/* Section: Now Playing — joining text, not labels */
"nowPlaying.metadataSeparator" = " — ";
"nowPlaying.a11ySeparator" = " de ";

/* Section: a Bluetooth device that has just connected */
"device.connected.a11y.battery" = "%1$@ conectado, batería al %2$lld por ciento";
"device.connected.a11y" = "%@ conectado";
"device.connected.battery" = "%lld %%";
"device.connected.subtitle" = "Conectado";

/* Section: a timer from Apple's Clock */
"timer.untitled" = "Temporizador";
"timer.paused" = "En pausa";
"timer.finished" = "Se acabó el tiempo";
"timer.finished.a11y" = "%@ ha terminado";

/* Section: the shelf. shelf.itemCount is a plural — Localizable.stringsdict */
"shelf.title" = "Estantería";

/* Section: what the actions menu offers to do to a file */
"convert.transcribe" = "Transcribir";
"convert.compressVideo" = "Comprimir el vídeo";
"convert.to" = "Convertir a %@";

/* Section: a joinable meeting */
"meeting.join" = "Entrar en %@";

/* Section: the glance, with nothing to show */
"glance.empty.granted" = "Nada más por hoy";
"glance.empty.notDetermined" = "Isleta todavía no te ha pedido acceso a tu calendario";
"glance.empty.denied" = "Activa el acceso al calendario en Ajustes del Sistema";
"glance.empty.restricted" = "El acceso al calendario está gestionado en este Mac";
"glance.empty.writeOnly" = "Isleta puede añadir eventos, pero no leerlos";

/* Section: the glance's own formatting */
"glance.startsIn.now" = "Empieza ahora";
"glance.startsIn.minutes" = "En %lld min";
"glance.startsIn.hours" = "En %lld h";
"glance.day.today" = "Hoy";
"glance.day.tomorrow" = "Mañana";
"glance.row.allDay" = "Todo el día";

/* Section: drop actions. "AirDrop" is Apple's own name and is not in this table. */
"dropAction.revealInFinder" = "Mostrar en el Finder";
"dropAction.copyToFolder" = "Copiar en una carpeta…";
"dropAction.moveToFolder" = "Mover a una carpeta…";
"dropAction.copyLink" = "Copiar enlace";

/* Section: work Isleta is doing to a file. fileAction.fileCount is a plural. */
"fileAction.a11y.running" = "%1$@, %2$@";
"fileAction.finished.subtitle" = "%@ en la estantería";
"fileAction.a11y.finished" = "%1$@ ha terminado, %2$@";
"fileAction.a11y.failed" = "%1$@ ha fallado, %2$@";

/* Section: weather */
"weather.unit.celsius" = "°C";
"weather.unit.fahrenheit" = "°F";
"weather.temperature.compact" = "%lld°";
"weather.temperature.full" = "%1$lld %2$@";
"weather.temperature.range" = "Máx %1$lld°  Mín %2$lld°";
"weather.percentage" = "%lld %%";

// Now Playing — the audio format badge. Apple ships these two terms
// untranslated in Music itself in every language Isleta speaks, so they are
// keys rather than literals only because the day one locale does translate
// them, this is where it goes.
"nowPlaying.format.lossless" = "Lossless";
"nowPlaying.format.hiResLossless" = "Hi-Res Lossless";
"nowPlaying.format.dolbyAtmos" = "Dolby Atmos";
"nowPlaying.format.multichannel" = "Multicanal";
