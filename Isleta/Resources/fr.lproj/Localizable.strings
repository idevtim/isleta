/* ---- Sources pane: what each source does, whether or not it can ---- */
"sources.nowPlaying.summary" = "Affiche le morceau en cours dans Musique, Spotify ou le lecteur du système.";
"sources.systemHUD.summary" = "Affiche les changements de volume, de sourdine, de luminosité de l’écran et de rétroéclairage du clavier dans l’îlot, à côté de l’indicateur du système lui-même.";
"sources.welcomeBack.summary" = "Vous accueille quand vous revenez à votre Mac après une absence.";
"sources.timer.summary" = "Affiche dans l’îlot le décompte des minuteurs de l’app Horloge d’Apple. Ne lit que l’état qu’Horloge conserve déjà sur ce Mac, et ne demande aucune autorisation.";
"sources.deviceConnected.summary" = "Affiche les AirPods et les autres appareils audio Bluetooth qui se connectent, avec leur charge. Demande l’accès Bluetooth pour les voir arriver — le nom et la charge de l’appareil ne quittent jamais votre Mac.";
"sources.shelf.summary" = "Garde les fichiers que vous faites glisser sur l’îlot.";
"sources.glance.summary" = "Affiche votre journée — ce qui vient ensuite dans votre calendrier, et la météo. Demande l’accès au calendrier, et à la localisation si vous voulez que la météo vous suive.";
"sources.calendarAlert.summary" = "Vous prévient quand un événement est sur le point de commencer.";
"sources.meeting.summary" = "Vous donne un bouton pour rejoindre un appel Zoom, Meet, Teams ou FaceTime quand une réunion commence.";
"sources.power.summary" = "Affiche l’adaptateur secteur qu’on branche et qu’on débranche, une batterie qui faiblit, et le mode économie d’énergie.";
"sources.call.summary" = "Affiche qu’un appel est en cours, et depuis combien de temps. macOS ne laisse pas les apps hors Apple voir qui appelle.";
"sources.fileAction.summary" = "Convertit, compresse et transcrit les fichiers que vous déposez sur l’îlot. Le travail se fait sur ce Mac ; rien n’est envoyé en ligne.";
"sources.focusChanged.summary" = "Indique quand une Concentration s’active ou se désactive — ce qui explique aussi pourquoi l’îlot se tait.";
"sources.screenSharing.summary" = "Vous rappelle que votre écran est en cours d’enregistrement ou de partage.";

