<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>logExport.done.detail</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 log file and the diagnostics report were written to:
%2$@</string>
			<key>other</key>
			<string>%1$lld log files and the diagnostics report were written to:
%2$@</string>
		</dict>
	</dict>
	<key>shelf.fileAway.failure.move</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 of %2$lld could not be moved</string>
			<key>other</key>
			<string>%1$lld of %2$lld could not be moved</string>
		</dict>
	</dict>
	<key>shelf.fileAway.failure.copy</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 of %2$lld could not be copied</string>
			<key>other</key>
			<string>%1$lld of %2$lld could not be copied</string>
		</dict>
	</dict>
	<key>shelf.fileAway.failedCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 file could not be filed</string>
			<key>other</key>
			<string>%lld files could not be filed</string>
		</dict>
	</dict>
</dict>
</plist>
