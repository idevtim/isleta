<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>logExport.done.detail</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 Protokolldatei und der Diagnosebericht wurden geschrieben nach:
%2$@</string>
			<key>other</key>
			<string>%1$lld Protokolldateien und der Diagnosebericht wurden geschrieben nach:
%2$@</string>
		</dict>
	</dict>
	<key>shelf.fileAway.failure.move</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 von %2$lld konnte nicht bewegt werden</string>
			<key>other</key>
			<string>%1$lld von %2$lld konnten nicht bewegt werden</string>
		</dict>
	</dict>
	<key>shelf.fileAway.failure.copy</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 von %2$lld konnte nicht kopiert werden</string>
			<key>other</key>
			<string>%1$lld von %2$lld konnten nicht kopiert werden</string>
		</dict>
	</dict>
	<key>shelf.fileAway.failedCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 Datei konnte nicht abgelegt werden</string>
			<key>other</key>
			<string>%lld Dateien konnten nicht abgelegt werden</string>
		</dict>
	</dict>
</dict>
</plist>
