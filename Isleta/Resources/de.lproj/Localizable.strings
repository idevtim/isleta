"sources.systemHUD.status.working" = "Funktioniert. Lautstärke, Stummschaltung und Helligkeit brauchen keine Berechtigung.";
"sources.systemHUD.status.unavailable" = "Dieser Mac meldet weder Lautstärke noch Displayhelligkeit oder Tastaturbeleuchtung, die Isleta anzeigen könnte.";
"sources.deviceConnected.status.noBattery" = "Isleta zeigt Geräte, die sich verbinden — aber diese macOS-Version meldet ihren Ladestand nicht mehr, deshalb wird keine Ladung angezeigt.";
"sources.deviceConnected.status.undetermined" = "Warten auf Bluetooth-Zugriff. macOS fragt einmal, beim Start von Isleta — wenn du diesen Dialog geschlossen hast, ohne zu antworten, beende Isleta und öffne es erneut.";
"sources.glance.status.granted" = "Erlaubt. Isleta zeigt deinen Tag und das Wetter.";
"sources.glance.status.grantedNoWeather" = "Erlaubt. Die Insel zeigt deinen Tag. Das Wetter ist in dieser Version noch nicht dabei.";
