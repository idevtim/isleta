/* ---- Sources pane: what each source does, whether or not it can ---- */
"sources.nowPlaying.summary" = "Zeigt den Titel, der in der Musik-App, in Spotify oder im Systemplayer läuft.";
"sources.systemHUD.summary" = "Zeigt Änderungen an Lautstärke, Stummschaltung, Displayhelligkeit und Tastaturbeleuchtung auf der Insel — neben der Anzeige, die das System selbst einblendet.";
"sources.welcomeBack.summary" = "Begrüßt dich, wenn du nach einer Weile an deinen Mac zurückkommst.";
"sources.timer.summary" = "Zeigt Timer aus Apples Uhr auf der Insel beim Herunterzählen. Liest nur den Zustand, den die Uhr ohnehin auf diesem Mac speichert, und braucht keine Berechtigung.";
"sources.deviceConnected.summary" = "Zeigt AirPods und andere Bluetooth-Audiogeräte, wenn sie sich verbinden, mit ihrem Ladestand. Braucht Bluetooth-Zugriff, um ihre Ankunft mitzubekommen — Name und Ladung des Geräts verlassen deinen Mac nie.";
"sources.shelf.summary" = "Hält Dateien, die du auf die Insel ziehst.";
"sources.glance.summary" = "Zeigt deinen Tag — was als Nächstes im Kalender ansteht, und das Wetter. Braucht Kalenderzugriff, und Ortungsdienste, wenn das Wetter dir folgen soll.";
"sources.calendarAlert.summary" = "Sagt dir, wenn ein Termin gleich beginnt.";
"sources.meeting.summary" = "Gibt dir eine Taste, um an einem Zoom-, Meet-, Teams- oder FaceTime-Anruf teilzunehmen, wenn ein Meeting beginnt.";
"sources.power.summary" = "Zeigt, wenn das Netzteil ein- und ausgesteckt wird, wenn die Batterie zur Neige geht, und den Stromsparmodus.";
"sources.call.summary" = "Zeigt, dass ein Anruf läuft, und wie lange schon. macOS lässt Apps außerhalb von Apple nicht sehen, wer anruft.";
"sources.fileAction.summary" = "Konvertiert, komprimiert und transkribiert Dateien, die du auf die Insel ziehst. Die Arbeit passiert auf diesem Mac; nichts wird hochgeladen.";
"sources.focusChanged.summary" = "Sagt, wenn ein Fokus an- oder ausgeht — was auch der Grund ist, warum die Insel still wird.";
"sources.screenSharing.summary" = "Erinnert dich daran, während dein Bildschirm aufgezeichnet oder geteilt wird.";

