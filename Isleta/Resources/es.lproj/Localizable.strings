/* ---- Sources pane: what each source does, whether or not it can ---- */
"sources.nowPlaying.summary" = "Muestra la canción que suena en Música, en Spotify o en el reproductor del sistema.";
"sources.systemHUD.summary" = "Muestra en la isla los cambios de volumen, de silencio, del brillo de la pantalla y de la retroiluminación del teclado, junto al indicador del propio sistema.";
"sources.welcomeBack.summary" = "Te saluda cuando vuelves a tu Mac después de un rato fuera.";
"sources.timer.summary" = "Muestra en la isla la cuenta atrás de los temporizadores de la app Reloj de Apple. Solo lee el estado que Reloj ya guarda en este Mac, y no necesita ningún permiso.";
"sources.deviceConnected.summary" = "Muestra los AirPods y otros dispositivos de audio Bluetooth cuando se conectan, con su carga. Necesita acceso a Bluetooth para verlos llegar: el nombre y la carga del dispositivo nunca salen de tu Mac.";
"sources.shelf.summary" = "Guarda los archivos que arrastras a la isla.";
"sources.glance.summary" = "Muestra tu día: lo siguiente en tu calendario, y el tiempo. Necesita acceso al calendario, y a la ubicación si quieres que el tiempo te siga.";
"sources.calendarAlert.summary" = "Te avisa cuando un evento está a punto de empezar.";
"sources.meeting.summary" = "Te da un botón para entrar en una llamada de Zoom, Meet, Teams o FaceTime cuando empieza una reunión.";
"sources.power.summary" = "Muestra cuándo se enchufa y se desenchufa el adaptador de corriente, cuándo se está agotando la batería, y el modo de bajo consumo.";
"sources.call.summary" = "Muestra que hay una llamada en curso, y cuánto lleva. macOS no deja que las apps ajenas a Apple vean quién llama.";
"sources.fileAction.summary" = "Convierte, comprime y transcribe los archivos que sueltas en la isla. El trabajo ocurre en este Mac; no se sube nada.";
"sources.focusChanged.summary" = "Dice cuándo se activa o se desactiva una Concentración, que es también el motivo por el que la isla se calla.";
"sources.screenSharing.summary" = "Te recuerda que tu pantalla se está grabando o compartiendo.";

